{
  "name": "sleepgenic-mcp",
  "main": "worker.js",
  "compatibility_date": "2026-08-13",
  "routes": [
    {
      "pattern": "mcp.sleepgenic.ai",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
